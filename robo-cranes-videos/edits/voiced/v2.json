 "narration": [
  {
   "start": 2.8,
   "end": 6.387,
   "text": "How do we score in Level Up? With bean bags!"
  },
  {
   "start": 7.087,
   "end": 10.323,
   "text": "Drop a bean bag in the floor goal: one point."
  },
  {
   "start": 10.923,
   "end": 14.01,
   "text": "Put it on top of the pyramid: three points!"
  },
  {
   "start": 14.61,
   "end": 16.167,
   "text": "Now here's the secret."
  },
  {
   "start": 16.567,
   "end": 23.229,
   "text": "Put a bag ON TOP of another bag on the pyramid, and it reaches the next level: six points!"
  },
  {
   "start": 23.579,
   "end": 24.671,
   "text": "That's double!"
  },
  {
   "start": 25.371,
   "end": 31.131,
   "text": "So the best teams drop every bag in the exact same spot, so they stack."
  },
  {
   "start": 31.631,
   "end": 35.918,
   "text": "One, three, six. Higher means more points!"
  }
 ],
