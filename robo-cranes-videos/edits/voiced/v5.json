 "narration": [
  {
   "start": 2.8,
   "end": 6.515,
   "text": "Every time Flop turns, it can be a tiny bit wrong."
  },
  {
   "start": 6.915,
   "end": 9.315,
   "text": "One little mistake is okay."
  },
  {
   "start": 9.815,
   "end": 14.515,
   "text": "But after many turns, the mistakes add up, and Flop gets lost!"
  },
  {
   "start": 14.915,
   "end": 20.435,
   "text": "The fix: instead of 'turn right 90,' use 'turn to heading.'"
  },
  {
   "start": 20.835,
   "end": 24.851,
   "text": "That means 'face that direction,' like 'face the window.'"
  },
  {
   "start": 25.251,
   "end": 29.891,
   "text": "Flop checks its compass every time, so mistakes don't pile up."
  },
  {
   "start": 30.291,
   "end": 31.651,
   "text": "Smart robot!"
  }
 ],
