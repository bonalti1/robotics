 "narration": [
  {
   "start": 2.8,
   "end": 5.231,
   "text": "Bean bags come in three colors."
  },
  {
   "start": 5.631,
   "end": 7.741,
   "text": "Red bags go on the red goal."
  },
  {
   "start": 10.141,
   "end": 12.433,
   "text": "Blue bags go on the blue goal."
  },
  {
   "start": 13.033,
   "end": 15.844,
   "text": "And yellow? Yellow is WILD!"
  },
  {
   "start": 16.194,
   "end": 18.016,
   "text": "It counts on any goal."
  },
  {
   "start": 18.416,
   "end": 23.533,
   "text": "If a bag is the wrong color, or still touching the robot, it's zero points."
  },
  {
