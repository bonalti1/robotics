  "narration": [
    {
      "start": 0.4,
      "end": 4.8,
      "text": "Hi Robo Cranes! I'm Cranebot, and this is Flop, our robot!"
    },
    {
      "start": 5.2,
      "end": 8.8,
      "text": "Flop has five parts, just like a body."
    },
    {
      "start": 9.3,
      "end": 13.8,
      "text": "Wheels are Flop's legs: they drive and turn."
    },
    {
      "start": 14.3,
      "end": 19.3,
      "text": "The intake is Flop's mouth: it grabs bean bags and spits them out."
    },
    {
      "start": 19.8,
      "end": 25.3,
      "text": "The arm is Flop's neck: it lifts bags up high, just like my long crane neck!"
    },
    {
      "start": 25.8,
      "end": 30.3,
      "text": "The camera is Flop's eyes: it sees red, blue and yellow."
    },
    {
      "start": 30.8,
      "end": 34.3,
      "text": "And the bumper is Flop's nose: boop!"
    },
    {
      "start": 35.0,
      "end": 40.3,
      "text": "Five parts, one robot, one team. Let's build it!"
    }
  ]
